# ShreeRam CRM — Environment Variables

# Copy values into backend/.env on the server. NEVER commit real secrets.

APP_NAME=ShreeRamCRM
APP_ENV=production
APP_DEBUG=false
APP_URL=https://aweliontech.com/shreeram-crm
ASSET_URL=https://aweliontech.com/shreeram-crm
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shreeram_crm
DB_USERNAME=shreeram_crm_user
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=info

# Meta (server-side only — never put these in Flutter)
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=

# Flutter build-time (non-secret)
# API_BASE_URL=https://aweliontech.com/shreeram-crm/api/v1
