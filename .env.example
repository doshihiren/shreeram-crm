# ShreeRam CRM — Environment Variables (planned)

# Copy to backend/.env and mobile config only when implementation starts.
# NEVER commit real secrets, tokens, or passwords.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=ShreeRamCRM
APP_ENV=local
APP_DEBUG=true
APP_URL=https://crm.example.com
APP_KEY=                          # php artisan key:generate (Laravel)

# -----------------------------------------------------------------------------
# Database (dedicated DB only — never point at other projects' databases)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shreeram_crm
DB_USERNAME=shreeram_crm_user
DB_PASSWORD=

# -----------------------------------------------------------------------------
# API / Auth (Laravel Sanctum)
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=         # Web origins if cookie/SPA mode used
SESSION_DOMAIN=
TOKEN_EXPIRATION_MINUTES=10080    # Example: 7 days; tune per security policy

# -----------------------------------------------------------------------------
# Meta Lead Ads (SERVER-SIDE ONLY — never ship to Flutter)
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=        # Random string; hashed/stored server-side
META_GRAPH_BASE_URL=https://graph.facebook.com
# Page access tokens should be stored encrypted in DB after Owner connects,
# not hard-coded here long-term. Optional bootstrap vars:
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Encryption / security
# -----------------------------------------------------------------------------
# Laravel APP_KEY encrypts DB "encrypted" casts (Meta tokens).
LOG_LEVEL=info
# Do not log Authorization headers or Meta tokens.

# -----------------------------------------------------------------------------
# Queue / cache (keep minimal on demo VPS)
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=database         # Use sync until webhook worker is enabled
CACHE_STORE=file
# REDIS_* only if explicitly approved and isolated

# -----------------------------------------------------------------------------
# Flutter client (mobile/.env or --dart-define) — NON-SECRET
# -----------------------------------------------------------------------------
API_BASE_URL=https://crm.example.com/api/v1
# No Meta secrets in Flutter env files.
